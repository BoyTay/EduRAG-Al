# Sao chép thành .env rồi thay toàn bộ giá trị mẫu. Không commit .env.
# Bắt buộc khi khởi tạo database mới; mật khẩu phải từ 12 ký tự trở lên.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# Các origin frontend được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000

# Model sinh câu trả lời và mức độ ngẫu nhiên.
# 0.3 giúp diễn đạt tự nhiên hơn; lượt rà soát giữ 0.0 để kiểm tra đủ ý ổn định.
LLM_MODEL=qwen3.5:9b
LLM_TEMPERATURE=0.3
LLM_AUDIT_TEMPERATURE=0.0

# Số candidate vòng đầu, số chunk đưa vào prompt và ngưỡng từ chối RAG.
# Các giá trị này cần tiếp tục hiệu chỉnh trên bộ câu hỏi thật.
RETRIEVAL_CANDIDATE_K=30
TOP_K=8

# Ngưỡng từ chối RAG (0.0–1.0). AITeamVN/Vietnamese_Embedding cosine range ~0.2–0.9
# Nếu quá nhiều từ chối hợp lệ (xem /admin/rag-refusals) → giảm xuống 0.22–0.25
# Nếu AI trả lời lạc đề hoặc bịa → tăng lên 0.35–0.40
MIN_RELEVANCE_SCORE=0.30

# Số chunk tối đa cho câu hỏi liệt kê. Mục quy chế dài có thể cần 15–20.
MAX_SECTION_CHUNKS=20

# Tesseract vie nhận dạng PDF scan tiếng Việt; model được cài trong image.
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_TESSERACT_PSM=6
OCR_TESSERACT_REMOVE_COLORED_OVERLAYS=true
OCR_DEVICE=cpu
OCR_DETECTION_MODEL=PP-OCRv6_small_det
OCR_RECOGNITION_MODEL=PP-OCRv6_small_rec
OCR_DPI=300
OCR_NATIVE_TEXT_THRESHOLD=50
OCR_SANITY_MIN_CHARS=3
OCR_BLANK_PIXEL_THRESHOLD=245
OCR_BLANK_DARK_RATIO=0.0005
OCR_BLANK_STDDEV=2.0

# Google Sign-In và email đặt lại mật khẩu (tuỳ chọn).
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
