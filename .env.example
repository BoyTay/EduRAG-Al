# Sao chép thành .env rồi thay toàn bộ giá trị mẫu. Không commit .env.
# Bắt buộc khi khởi tạo database mới; mật khẩu phải từ 12 ký tự trở lên.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# Các origin frontend được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000

# Số candidate vòng đầu, số chunk đưa vào prompt và ngưỡng từ chối RAG.
# Các giá trị này cần tiếp tục hiệu chỉnh trên bộ câu hỏi thật.
RETRIEVAL_CANDIDATE_K=30
TOP_K=8
MIN_RELEVANCE_SCORE=0.30

# PP-OCRv6 Small fallback cho từng trang PDF thiếu native text.
# Lần chạy OCR đầu tiên cần mạng để tải model vào named volume.
OCR_ENABLED=true
OCR_DEVICE=cpu
OCR_DETECTION_MODEL=PP-OCRv6_small_det
OCR_RECOGNITION_MODEL=PP-OCRv6_small_rec
OCR_DPI=200
OCR_NATIVE_TEXT_THRESHOLD=50
OCR_SANITY_MIN_CHARS=3
OCR_BLANK_PIXEL_THRESHOLD=245
OCR_BLANK_DARK_RATIO=0.0005
OCR_BLANK_STDDEV=2.0

# Google Sign-In và email đặt lại mật khẩu (tuỳ chọn).
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
