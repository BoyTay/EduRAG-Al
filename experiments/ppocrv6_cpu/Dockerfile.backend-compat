FROM edurag_backend

ARG PADDLE_INDEX_URL=https://www.paddlepaddle.org.cn/packages/stable/cpu/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=1 \
    PADDLE_PDX_CACHE_HOME=/opt/ppocr-cache

WORKDIR /spike

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir kubernetes==35.0.0 \
    && python -m pip install --no-cache-dir \
      --index-url "${PADDLE_INDEX_URL}" paddlepaddle==3.3.0 \
    && python -m pip install --no-cache-dir paddleocr==3.7.0 \
    && python -m pip check

COPY experiments/ppocrv6_cpu/smoke_test.py /spike/smoke_test.py

CMD ["python", "/spike/smoke_test.py"]
